# =========================
# 🔬 MLflow
# =========================
# Note: Directory renamed from "mlflow" to "mlflow_artifacts" to avoid
# namespace conflict with the mlflow Python package
/mlflow_artifacts/quickstart/*
!/mlflow_artifacts/quickstart/.gitkeep
mlruns/
mlflow_artifacts/dev/*.db
mlflow_artifacts/dev/*.db-shm
mlflow_artifacts/dev/*.db-wal
mlflow_artifacts/dev/mlruns/
mlflow_artifacts/dev/artifacts/

# =========================
# 📊 DVC
# Ignorar datasets, pero mantener los .dvc
# =========================
data
# DVC config with credentials should not be versioned (use .dvc/config.example as template)
.dvc/config
.dvc/config.local
.dvc/tmp/

# =========================
# 🤖 Models (use DVC for versioning)
# =========================
models/
!models/.gitkeep

