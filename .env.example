# MLflow Configuration
# Copy this file to .env and customize as needed

# MLflow Tracking URI (optional override)
# By default, the project uses the local dev environment: sqlite:///mlflow/dev/mlflow.db
# Uncomment and modify to use a different tracking server:

# For local quickstart environment (learning/experimentation):
# MLFLOW_TRACKING_URI=sqlite:///mlflow/quickstart/mlflow.db

# For local dev environment (actual development - this is the default):
# MLFLOW_TRACKING_URI=sqlite:///mlflow/dev/mlflow.db

# For remote MLflow tracking server:
# MLFLOW_TRACKING_URI=http://mlflow-server:5000

# For cloud-based tracking (e.g., Databricks, AWS, etc):
# MLFLOW_TRACKING_URI=databricks://workspace-name
# MLFLOW_TRACKING_URI=http://your-cloud-mlflow-server.com

# Other optional MLflow settings:
# MLFLOW_EXPERIMENT_NAME=my-experiment
# MLFLOW_TRACKING_USERNAME=your-username
# MLFLOW_TRACKING_PASSWORD=your-password

# ==============================================================================
# Model Serving Configuration (FastAPI)
# ==============================================================================

# Model Configuration
MODEL_NAME=RandomForestBase
MODEL_LOAD_STRATEGY=local  # Options: local, mlflow
MODEL_PATH=models/randomforestbase_best_20251102_165526.pkl

# MLflow Model Loading (only if MODEL_LOAD_STRATEGY=mlflow)
# MLFLOW_RUN_ID=your-run-id-here
# MLFLOW_MODEL_NAME=your-model-name

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false  # Set to true for development with auto-reload
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
